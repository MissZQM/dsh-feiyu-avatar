{
  "name": "dsh-feiyu-avatar",
  "version": "0.1.0",
  "description": "给 DeepSeek Harness 的 Web 聊天加上微信那样的双侧头像：你的消息右侧一个、AI 回复左侧一个，各自可上传、可调大小。",
  "type": "module",
  "license": "MIT",
  "author": "MissZQM (https://github.com/MissZQM)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MissZQM/dsh-feiyu-avatar.git"
  },
  "homepage": "https://github.com/MissZQM/dsh-feiyu-avatar#readme",
  "bugs": {
    "url": "https://github.com/MissZQM/dsh-feiyu-avatar/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "avatar",
    "chat",
    "ui"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  }
}
